    {
      "type": "stat",
      "title": "Equity change (range)",
      "description": "Last minus first total equity in the range, net of deposits/withdrawals.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH e AS (SELECT ts, equity FROM equity_1m WHERE $__timeFilter(ts))\n        SELECT (SELECT equity FROM e ORDER BY ts DESC LIMIT 1) - (SELECT equity FROM e ORDER BY ts LIMIT 1)\n             - coalesce((SELECT sum(usdc) FROM flow WHERE $__timeFilter(ts) AND kind IN ('deposit','withdraw')), 0) AS change"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
