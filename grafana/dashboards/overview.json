    {
      "type": "stat",
      "title": "Maker+taker edge (range)",
      "description": "Sum of realised pair edge (real_bp x io notional) of the bot's maker and taker trades.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce((SELECT sum(real_bp / 1e4 * sz * px_io) FROM bot_maker WHERE $__timeFilter(ts)),0)\n             + coalesce((SELECT sum(real_bp / 1e4 * sz_io * px_io) FROM bot_taker WHERE $__timeFilter(ts)),0) AS edge"
        }
