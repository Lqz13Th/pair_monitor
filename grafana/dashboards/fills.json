            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, venue AS metric, sum(fee) OVER (PARTITION BY venue ORDER BY ts) AS value FROM fill WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
