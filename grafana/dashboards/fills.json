    {
      "type": "table",
      "title": "By venue and symbol",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT venue, sym, count(*) AS fills, round(sum(notional)::numeric,0) AS volume, round(100.0*avg(maker::int),1) AS \"maker %\",\n               round(sum(fee)::numeric,4) AS fees, round((1e4*sum(fee)/nullif(sum(notional),0))::numeric,3) AS \"fee bp\",\n               round(sum(closed_pnl)::numeric,4) AS \"closed pnl (HL)\"\n        FROM fill WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY volume DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "volume"
            },
            "properties": [
