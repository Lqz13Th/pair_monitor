    {
      "type": "table",
      "title": "Maker trades by symbol",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sym, count(*) AS trades, round(avg(plan_bp)::numeric,2) AS \"avg plan bp\", round(avg(real_bp)::numeric,2) AS \"avg real bp\",\n          round(avg(real_bp - plan_bp)::numeric,2) AS \"avg slip bp\", round(sum(real_bp / 1e4 * sz * px_io)::numeric,4) AS \"edge USD\",\n          round(sum(sz * px_io)::numeric,0) AS \"notional USD\", round(percentile_cont(0.5) WITHIN GROUP (ORDER BY hedge_delay_ms)::numeric,0) AS \"p50 hedge ms\",\n          round(percentile_cont(0.9) WITHIN GROUP (ORDER BY hedge_delay_ms)::numeric,0) AS \"p90 hedge ms\", round(100.0*avg((real_bp > 0)::int),1) AS \"win %\"\n        FROM bot_maker WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) GROUP BY 1 ORDER BY trades DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "edge USD"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      },
