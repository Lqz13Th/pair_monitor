    {
      "type": "timeseries",
      "title": "Net notional per symbol (all venues)",
      "description": "Should stay near 0: the legs hedge each other.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time, sym AS metric, sum(n) AS value FROM (\n          SELECT $__timeGroupAlias(ts, '1m'), venue, sym, last(notional, ts) AS n FROM position WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) GROUP BY 1, 2, 3) t\n        GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false,
