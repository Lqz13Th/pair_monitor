          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), venue || ' ' || sym AS metric, min(liq_dist_pct) AS value FROM position WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) AND size <> 0 GROUP BY 1, 2 ORDER BY 1"
