    {
      "type": "barchart",
      "title": "Peak |deviation| (bp)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT bucket, episodes FROM (\n          SELECT least(floor(abs(peak_dev_bp)), 12) AS k,\n                 CASE WHEN abs(peak_dev_bp) >= 12 THEN '12+' ELSE floor(abs(peak_dev_bp))::int::text END AS bucket, count(*) AS episodes\n          FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) GROUP BY 1, 2) t ORDER BY k"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "stacking": "none",
        "showValue": "auto",
