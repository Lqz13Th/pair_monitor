    {
      "type": "barchart",
      "title": "Time to converge (s)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN duration_s < 5 THEN '0-5' WHEN duration_s < 15 THEN '5-15' WHEN duration_s < 30 THEN '15-30'\n                    WHEN duration_s < 60 THEN '30-60' WHEN duration_s < 120 THEN '60-120' WHEN duration_s < 300 THEN '120-300'\n                    WHEN duration_s < 900 THEN '300-900' ELSE '900+' END AS bucket, count(*) AS episodes\n        FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) AND end_reason = 'converged'\n        GROUP BY 1 ORDER BY min(duration_s)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "stacking": "none",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      },
      "id": 7,
      "gridPos": {
