    {
      "type": "table",
      "title": "Episodes by pair",
      "description": "Duration = confirm to |dev| <= exit. Peak edge = best touch edge toward the midline while open; net = minus round-trip taker fees.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sym, pair, count(*) AS episodes,\n          round(100.0 * avg((end_reason = 'converged')::int), 1) AS \"converged %\",\n          round(100.0 * avg((end_reason = 'timeout')::int), 1) AS \"timeout %\",\n          round(percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_s) FILTER (WHERE end_reason = 'converged')::numeric, 1) AS \"p50 converge s\",\n          round(percentile_cont(0.9) WITHIN GROUP (ORDER BY duration_s) FILTER (WHERE end_reason = 'converged')::numeric, 1) AS \"p90 converge s\",\n          round(percentile_cont(0.5) WITHIN GROUP (ORDER BY half_s)::numeric, 1) AS \"p50 half s\",\n          round(avg(abs(peak_dev_bp))::numeric, 2) AS \"avg |peak dev|\",\n          round(avg(peak_edge_bp)::numeric, 2) AS \"avg peak edge\",\n          round(avg(peak_edge_bp - rt_fee_bp)::numeric, 2) AS \"avg net edge\",\n          round(100.0 * avg((peak_edge_bp > rt_fee_bp)::int), 1) AS \"edge > fees %\"\n        FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) GROUP BY 1, 2 ORDER BY episodes DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pm-db"
      }
    },
    {
      "type": "table",
      "title": "By US session phase",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT phase, count(*) AS episodes, round(100.0 * avg((end_reason = 'converged')::int), 1) AS \"converged %\",\n          round(percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_s) FILTER (WHERE end_reason = 'converged')::numeric, 1) AS \"p50 converge s\",\n          round(avg(abs(peak_dev_bp))::numeric, 2) AS \"avg |peak dev|\", round(avg(peak_edge_bp - rt_fee_bp)::numeric, 2) AS \"avg net edge\"\n        FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pm-db"
      }
    },
    {
      "type": "table",
      "title": "By end reason",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(end_reason, 'open') AS reason, count(*) AS episodes, round(avg(duration_s)::numeric, 1) AS \"avg s\",\n          round(avg(abs(peak_dev_bp))::numeric, 2) AS \"avg |peak dev|\", round(avg(abs(end_dev_bp))::numeric, 2) AS \"avg |end dev|\"\n        FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": []
