    {
      "type": "table",
      "title": "Episodes",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT start_ts, pair, dir, phase, round(confirm_dev_bp::numeric,2) AS confirm_dev, round(peak_dev_bp::numeric,2) AS peak_dev,\n               round(peak_edge_bp::numeric,2) AS peak_edge, round((peak_edge_bp - rt_fee_bp)::numeric,2) AS peak_edge_net,\n               round(half_s::numeric,1) AS half_s, round(duration_s::numeric,1) AS duration_s, coalesce(end_reason,'open') AS end\n        FROM episode WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(start_ts) ORDER BY start_ts DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "half_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
