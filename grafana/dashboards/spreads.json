    {
      "type": "timeseries",
      "title": "Edge toward the midline vs round-trip fees",
      "description": "Touch-to-touch edge of trading toward the midline now (positive = capturable before exit costs); rt fee = taker fees of a full round trip.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, pair || ' sell a' AS metric, sell_a_vs_mid_bp AS value FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts)\n        UNION ALL SELECT ts, pair || ' buy a', buy_a_vs_mid_bp FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts)\n        UNION ALL SELECT ts, pair || ' rt fee', rt_fee_bp FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts) ORDER BY 1"
        }
      ],
