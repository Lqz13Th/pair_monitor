          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(ts, '10s'), venue || ' bid' AS metric, avg(bid_sz * bid) AS value FROM book WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) GROUP BY 1, 2 UNION ALL SELECT $__timeGroupAlias(ts, '10s'), venue || ' ask', avg(ask_sz * ask) FROM book WHERE sym IN (${sym:sqlstring}) AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
