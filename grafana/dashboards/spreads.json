    {
      "type": "timeseries",
      "title": "Premium, midline and band",
      "description": "prem = (mid_a / mid_b - 1) x 1e4; midline = rolling 1 h in-session median (pair_arb's).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, pair || ' prem' AS metric, prem_bp AS value FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts)\n        UNION ALL SELECT ts, pair || ' midline', midline_bp FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts)\n        UNION ALL SELECT ts, pair || ' +band', midline_bp + $band FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts)\n        UNION ALL SELECT ts, pair || ' -band', midline_bp - $band FROM spread WHERE sym IN (${sym:sqlstring}) AND pair IN (${pair:sqlstring}) AND $__timeFilter(ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false,
            "pointSize": 4
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
